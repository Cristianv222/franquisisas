# ============================================================
#  franquisisas — variables de entorno (ejemplo)
#  Copia este archivo a .env y ajusta los valores.
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ---------- Postgres (contenedor) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ---------- Base del servicio auth ----------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth

# ---------- Base del servicio franquicias ----------
FRANQUICIAS_DB_NAME=franquicias_db
FRANQUICIAS_DB_USER=franquicias_user
FRANQUICIAS_DB_PASSWORD=change-me-franquicias

# ---------- Base del servicio notificaciones ----------
NOTIFICACIONES_DB_NAME=notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones_user
NOTIFICACIONES_DB_PASSWORD=change-me-notificaciones

# ---------- Django (común a los servicios) ----------
DJANGO_SECRET_KEY=change-me-dev-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,auth,franquicias,notificaciones,nginx

# ---------- JWT (RS256) ----------
# Las claves se montan en /keys dentro de cada contenedor.
JWT_PRIVATE_KEY_PATH=/keys/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public.pem
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# ---------- Redis (channel layer de notificaciones) ----------
# Redis exige contraseña. El REDIS_URL se arma en docker-compose a partir de
# esta variable; el puerto 6379 NUNCA se expone al host (solo red interna).
REDIS_PASSWORD=change-me-redis

# ---------- URLs internas servicio-a-servicio ----------
AUTH_INTERNAL_URL=http://auth:8000

# ---------- Resend (correo) ----------
# Deja RESEND_API_KEY vacío en dev: la contraseña se muestra/copia en el panel
# y no se intenta enviar correo. Para enviar de verdad, agrega tu API key y,
# para enviar a cualquier correo, un dominio verificado como RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
