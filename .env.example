# ============================================================
#  franquisisas — variables de entorno (ejemplo)
#  Copia este archivo a .env y completa los secretos antes de iniciar Docker.
#  Genera cada secreto con: openssl rand -hex 32
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ---------- Postgres (contenedor) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ---------- Base del servicio auth ----------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=

# ---------- Base del servicio franquicias ----------
FRANQUICIAS_DB_NAME=franquicias_db
FRANQUICIAS_DB_USER=franquicias_user
FRANQUICIAS_DB_PASSWORD=

# ---------- Base del servicio notificaciones ----------
NOTIFICACIONES_DB_NAME=notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones_user
NOTIFICACIONES_DB_PASSWORD=

# ---------- Django (común a los servicios) ----------
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=franqor.fronteratech.ec,localhost,127.0.0.1,auth,franquicias,notificaciones,nginx

# ---------- JWT (RS256) ----------
# Las claves se montan en /keys dentro de cada contenedor.
JWT_PRIVATE_KEY_PATH=/keys/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public.pem
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# ---------- Redis (channel layer de notificaciones) ----------
# Redis no publica su puerto al host.
REDIS_PASSWORD=

# ---------- URLs internas servicio-a-servicio ----------
AUTH_INTERNAL_URL=http://auth:8000

# ---------- Resend (correo) ----------
# Si RESEND_API_KEY está vacío, el sistema no envía correos. Para activarlos,
# agrega una API key válida y un remitente verificado en RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
